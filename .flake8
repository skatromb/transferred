[flake8]
# Just for the `wemake-python-styleguide`. `E999` is to fail on unparseable files
select = WPS, E999

# flake8 reads no `.gitignore`, and its own defaults miss these two
extend-exclude =
    .venv
    .agents
    perf/.venvs
    target

per-file-ignores =
    # Don't forbid `print`s in examples code
    examples/*.py: WPS421
    # Don't forbid for duplicate literals in tests
    crates/transferred-py/tests/*.py: WPS226
